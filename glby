<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>哥伦比亚 · 长裤</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#111214; --ink2:#4a4d52; --ink3:#8d9098; --line:#e8e8ea; --line2:#f2f2f4;
  --bg:#ffffff; --soft:#fafafa;
  --sans:"Helvetica Neue","Inter","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
}
html{-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:400;
  font-size:14px;line-height:1.75;-webkit-font-smoothing:antialiased;letter-spacing:.01em}
img{display:block;max-width:100%}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:inherit}

/* ---------- 顶栏 ---------- */
.topbar{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);
  backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--line)}
.topbar-in{padding:0 clamp(24px,4vw,84px);height:74px;display:flex;align-items:center;gap:40px}
.brand{display:flex;align-items:baseline;gap:10px;white-space:nowrap}
.brand b{font-size:14px;font-weight:600;letter-spacing:.02em}
.brand span{font-size:10.5px;letter-spacing:.18em;color:var(--ink3);text-transform:uppercase}
.nav{margin-left:auto;display:flex;gap:2px}
.nav button{padding:8px 16px;font-size:13px;color:var(--ink3);border-radius:2px;letter-spacing:.03em;
  transition:color .18s,border-color .18s;border-bottom:1px solid transparent}
.nav button:hover{color:var(--ink)}
.nav button.on{color:var(--ink);font-weight:500;border-bottom-color:var(--ink)}
.nav button i{font-style:normal;color:#c9cbd0;margin-right:7px;font-size:11px;letter-spacing:.06em}
.nav button.on i{color:var(--ink3)}

/* ---------- 容器 ---------- */
.wrap{padding:0 clamp(24px,4vw,84px)}
.panel{display:none;padding:clamp(46px,4vw,88px) 0 clamp(80px,6vw,130px)}
.panel.on{display:block;animation:fade .35s ease both}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ---------- 标题 ---------- */
.eyebrow{font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink3);margin-bottom:18px}
h1{font-size:clamp(38px,4.5vw,76px);line-height:1.16;font-weight:500;letter-spacing:-.025em;max-width:1180px}
h1 em{font-style:normal;border-bottom:1px solid var(--ink);padding-bottom:2px}
.sub{margin-top:22px;max-width:880px;color:var(--ink2);font-size:clamp(13.5px,1vw,15.5px)}
.rule{height:1px;background:var(--line);margin:38px 0 0}

.sec-hd{display:flex;align-items:baseline;gap:22px;margin:0 0 30px}
.sec-hd .no{font-size:11px;color:var(--ink3);letter-spacing:.14em}
.sec-hd h2{font-size:clamp(19px,1.35vw,24px);font-weight:500;letter-spacing:-.01em}
.sec-hd p{color:var(--ink3);font-size:12.5px;margin-left:auto}
.note{color:var(--ink3);font-size:12.5px;max-width:760px;margin-bottom:26px}

/* ---------- 数据条 ---------- */
.stats{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);margin:40px 0 0}
.stats div{padding:26px 0 26px clamp(20px,2vw,40px);border-left:1px solid var(--line)}
.stats div:first-child{border-left:0;padding-left:0}
.stats span{display:block;font-size:10.5px;letter-spacing:.12em;color:var(--ink3);text-transform:uppercase}
.stats b{display:block;font-size:clamp(22px,1.75vw,34px);font-weight:500;margin-top:8px;letter-spacing:-.02em}

/* ---------- 表 ---------- */
.tbl{width:100%;border-collapse:collapse;font-size:13.2px}
.tbl th{text-align:left;font-weight:500;color:var(--ink3);font-size:10.5px;letter-spacing:.1em;
  text-transform:uppercase;padding:0 16px 12px 0;border-bottom:1px solid var(--ink);white-space:nowrap}
.tbl td{padding:18px 22px 18px 0;border-bottom:1px solid var(--line);vertical-align:top;color:var(--ink2);line-height:1.7}
.tbl td:first-child{color:var(--ink);font-weight:500;white-space:nowrap}
.tbl tr:last-child td{border-bottom:1px solid var(--ink);color:var(--ink);background:var(--soft)}
.tbl .num{white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--ink)}
.bar{display:block;height:2px;background:var(--line);margin-top:8px;width:74px;position:relative}
.bar i{position:absolute;left:0;top:0;height:2px;background:var(--ink);display:block}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.scroll .tbl{min-width:900px}

/* ---------- 图表 ---------- */
.charts{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2vw,34px)}
.chart{border:1px solid var(--line);padding:clamp(18px,1.6vw,30px) clamp(14px,1.4vw,26px) 16px}
.chart h3{font-size:12px;font-weight:500;letter-spacing:.06em;color:var(--ink2);margin-bottom:14px}
.chart img{width:100%;height:auto}

/* ---------- 温度带 ---------- */
.bands{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);
  border:1px solid var(--line);margin-top:26px}
.band{background:#fff;padding:clamp(20px,1.8vw,32px) clamp(18px,1.6vw,28px) clamp(24px,2vw,36px)}
.band .t{font-size:11px;letter-spacing:.1em;color:var(--ink3);text-transform:uppercase}
.band .d{font-size:clamp(24px,1.9vw,34px);font-weight:500;margin:10px 0 6px;letter-spacing:-.03em}
.band .c{font-size:11.5px;color:var(--ink3);min-height:34px}
.band dl{margin-top:14px;border-top:1px solid var(--line2);padding-top:12px}
.band dt{font-size:10px;letter-spacing:.12em;color:var(--ink3);text-transform:uppercase;margin-top:10px}
.band dd{font-size:12px;color:var(--ink2);margin-top:2px;line-height:1.65}
.band dd b{font-weight:500;color:var(--ink)}

/* ---------- 图库 ---------- */
.galbar{display:flex;align-items:center;gap:8px;margin-bottom:22px;flex-wrap:wrap}
.galbar .cnt{color:var(--ink3);font-size:12px;margin-left:auto;letter-spacing:.04em}
.chip{font-size:11.5px;padding:5px 12px;border:1px solid var(--line);color:var(--ink3);border-radius:999px;transition:.18s}
.chip:hover{border-color:var(--ink3);color:var(--ink)}
.chip.on{border-color:var(--ink);color:var(--ink);background:var(--ink);color:#fff}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(clamp(120px,9vw,200px),1fr));gap:8px}
.gal figure{position:relative;background:var(--soft);cursor:zoom-in;overflow:hidden}
.gal img{width:100%;aspect-ratio:3/4;object-fit:cover;transition:opacity .25s,transform .5s}
.gal figure:hover img{opacity:.86}
.gal figcaption{position:absolute;left:0;bottom:0;font-size:9.5px;letter-spacing:.1em;color:#fff;
  background:rgba(0,0,0,.34);padding:2px 6px;opacity:0;transition:opacity .2s}
.gal figure:hover figcaption{opacity:1}
.gal.hide-sm figure[data-t="sm"],.gal.only-sm figure[data-t="hd"]{display:none}

/* ---------- 灯箱 ---------- */
.lb{position:fixed;inset:0;z-index:100;background:rgba(255,255,255,.98);display:none;
  align-items:center;justify-content:center;flex-direction:column;padding:56px 24px}
.lb.on{display:flex}
.lb img{max-width:min(1000px,92vw);max-height:78vh;object-fit:contain;box-shadow:0 12px 60px rgba(0,0,0,.12)}
.lb .meta{margin-top:18px;font-size:11px;letter-spacing:.16em;color:var(--ink3)}
.lb .x{position:absolute;top:22px;right:28px;font-size:22px;color:var(--ink3);line-height:1}
.lb .x:hover{color:var(--ink)}
.lb .pv,.lb .nx{position:absolute;top:50%;transform:translateY(-50%);font-size:26px;color:#c9cbd0;padding:20px}
.lb .pv{left:14px}.lb .nx{right:14px}
.lb .pv:hover,.lb .nx:hover{color:var(--ink)}

/* ---------- 声明 ---------- */
.decl{border-top:1px solid var(--ink)}
.decl section{display:grid;grid-template-columns:clamp(160px,16vw,300px) 1fr;gap:clamp(30px,4vw,80px);padding:clamp(24px,2.2vw,38px) 0;border-bottom:1px solid var(--line)}
.decl h3{font-size:13px;font-weight:500;letter-spacing:.02em}
.decl p{color:var(--ink2);font-size:13.2px;line-height:2}
.decl .lead{padding:22px 0 4px;color:var(--ink2);font-size:13px;grid-column:1/-1}

.foot{border-top:1px solid var(--line);margin-top:70px;padding:26px 0 0;display:flex;gap:24px;
  font-size:11px;color:var(--ink3);letter-spacing:.06em;flex-wrap:wrap}
.foot span:last-child{margin-left:auto}

@media (max-width:1080px){
  .gal{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}
  .bands{grid-template-columns:repeat(2,1fr)}
  .charts{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(3,1fr)}
  .stats div:nth-child(4){border-left:0;padding-left:0}
}
@media (max-width:760px){
  .topbar-in{padding:0 20px;height:auto;flex-direction:column;align-items:flex-start;gap:0;padding-top:14px}
  .nav{margin:0;width:100%;overflow-x:auto;padding:10px 0 0;gap:0}
  .nav button{padding:8px 12px 10px;white-space:nowrap}
  .wrap{padding:0 20px}
  .panel{padding:36px 0 64px}
  h1{font-size:27px}
  .stats{grid-template-columns:repeat(2,1fr)}
  .gal{grid-template-columns:repeat(2,1fr);gap:4px}
  .bands{grid-template-columns:1fr}
  .decl section{grid-template-columns:1fr;gap:8px;padding:20px 0}
  .sec-hd{flex-wrap:wrap;gap:8px}
  .sec-hd p{margin:0;width:100%}
}

/* ---------- 当前日期标注 ---------- */
.datechip{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--line);
  padding:8px 16px;font-size:11.5px;letter-spacing:.1em;color:var(--ink2);margin-top:26px}
.datechip b{font-weight:500;color:var(--ink);letter-spacing:.04em}
.datechip em{font-style:normal;color:var(--ink3)}
.chartbox{position:relative}
.chartbox .today{position:absolute;top:4.4%;bottom:11.5%;width:0;border-left:1px dashed #111;
  pointer-events:none;z-index:2}
.chartbox .today i{position:absolute;top:0;right:7px;font-style:normal;font-size:9.5px;
  letter-spacing:.12em;color:#111;background:#fff;padding:1px 5px;white-space:nowrap;
  border:1px solid var(--line)}
.chartnote{font-size:11px;letter-spacing:.06em;color:var(--ink3);margin-top:10px}
.chartnote b{font-weight:500;color:var(--ink2)}
</style>
