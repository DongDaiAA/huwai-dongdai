        <p>人口、气候数据为公开资料汇总与估算，气温曲线依据公开气象平均值得出；方位划分为分析用简化划分，不代表行政统计口径。</p>
      </section>
    </div>

    <div class="foot">
      <span>哥伦比亚 · 长裤</span>
      <span>Field Study 2026</span>
      <span>共 200 款 · 5 方位 · 2 组气温曲线</span>
    </div>
  </section>

</main>

<div class="lb" id="lb">
  <button class="x" id="lbx" aria-label="关闭">×</button>
  <button class="pv" id="lbp" aria-label="上一张">‹</button>
  <img id="lbi" alt="">
  <div class="meta" id="lbm"></div>
  <button class="nx" id="lbn" aria-label="下一张">›</button>
</div>

<script>
(function(){
  var nav=document.getElementById('nav');
  var panels=[].slice.call(document.querySelectorAll('.panel'));
  nav.addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b) return;
    [].forEach.call(nav.querySelectorAll('button'),function(x){x.classList.toggle('on',x===b)});
    panels.forEach(function(p){p.classList.toggle('on',p.id===b.dataset.p)});
    window.scrollTo({top:0,behavior:'instant'});
  });

  var grids=[].slice.call(document.querySelectorAll('#p1 .gal'));
  var figs=[];
  grids.forEach(function(g){figs=figs.concat([].slice.call(g.querySelectorAll('figure')))});

  var lb=document.getElementById('lb'),lbi=document.getElementById('lbi'),lbm=document.getElementById('lbm');
  var idx=0;
  function show(i){
    var list=figs.filter(function(x){return getComputedStyle(x).display!=='none'});
    if(!list.length) return;
    idx=(i+list.length)%list.length;
    var f=list[idx], im=f.querySelector('img');
    lbi.src=im.dataset.full||im.src;
    lbm.textContent=(idx+1)+' / '+list.length+'  ·  '+f.dataset.i;
    lb.classList.add('on');
  }
  grids.forEach(function(g){
    g.addEventListener('click',function(e){
      var f=e.target.closest('figure'); if(!f) return;
      var list=figs.filter(function(x){return getComputedStyle(x).display!=='none'});
      show(list.indexOf(f));
    });
  });
  document.getElementById('lbx').onclick=function(){lb.classList.remove('on')};
  document.getElementById('lbp').onclick=function(){show(idx-1)};
  document.getElementById('lbn').onclick=function(){show(idx+1)};
  lb.addEventListener('click',function(e){if(e.target===lb)lb.classList.remove('on')});
  document.addEventListener('keydown',function(e){
    if(!lb.classList.contains('on'))return;
    if(e.key==='Escape')lb.classList.remove('on');
    if(e.key==='ArrowLeft')show(idx-1);
    if(e.key==='ArrowRight')show(idx+1);
  });
})();
</script>
</body>
</html>
